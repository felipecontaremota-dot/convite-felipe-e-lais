{
  "name": "convite-felipe-e-lais",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:web": "expo export --platform web && node scripts/web-assets.mjs",
    "test:e2e": "playwright test",
    "test:db": "bash scripts/test-db.sh",
    "check:functions": "deno check --config supabase/functions/deno.json supabase/functions/redeem-invitation/index.ts supabase/functions/dispatch-notifications/index.ts supabase/functions/sync-sheets/index.ts supabase/functions/send-invitations/index.ts",
    "import:report": "tsx scripts/import-guests.ts",
    "format": "prettier --write app src tests scripts docs *.json *.ts *.js README.md .github/workflows/*.yml",
    "test:functions": "deno test --config supabase/functions/deno.json --allow-env supabase/functions/_shared/providers.test.ts supabase/functions/redeem-invitation/handler.test.ts supabase/functions/dispatch-notifications/handler.test.ts supabase/functions/send-invitations/handler.test.ts supabase/functions/_shared/cors.test.ts",
    "serve:web": "node scripts/serve-web.mjs",
    "test:export": "node scripts/test-export.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~57.0.27",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "^0.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.3.0",
    "deno": "^2.9.6",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
